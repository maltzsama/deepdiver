{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["image", "activeRecordEncryption", "env"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "env": {
      "type": "object",
      "description": "trinoUrl and trinoDeployment are read with a bare ENV.fetch in the app, so an empty value is a KeyError on the first engine start. Both must be non-empty.",
      "required": ["trinoUrl", "trinoDeployment"],
      "properties": {
        "trinoUrl": { "type": "string", "minLength": 1, "format": "uri" },
        "trinoDeployment": { "type": "string", "minLength": 1 },
        "trinoWorkerDeployment": { "type": "string" },
        "trinoNamespace": { "type": "string" },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "host": { "type": "string" },
        "allowedHosts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "bootstrap": {
          "type": "object",
          "description": "Both or neither: seeds.rb does ENV.fetch on the password, so an email without a password fails the migration Job.",
          "properties": {
            "email": { "type": "string" },
            "password": { "type": "string" }
          },
          "allOf": [
            {
              "if": { "required": ["email"], "properties": { "email": { "minLength": 1 } } },
              "then": { "required": ["password"], "properties": { "password": { "minLength": 1 } } }
            },
            {
              "if": { "required": ["password"], "properties": { "password": { "minLength": 1 } } },
              "then": { "required": ["email"], "properties": { "email": { "minLength": 1 } } }
            }
          ]
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "activeRecordEncryption": {
      "type": "object",
      "required": ["existingSecret"],
      "properties": {
        "existingSecret": { "type": "string" }
      }
    },
    "trino": {
      "type": "object",
      "properties": {
        "provisioner": { "type": "string", "enum": ["chart", "baleia", "fake"] }
      }
    },
    "oidc": {
      "type": "object",
      "description": "Setting issuer turns SSO_ENABLED on for every process. config/initializers/devise.rb then does ENV.fetch on clientId, clientSecret and redirectUri, so a partial config yields a login button that cannot complete a flow.",
      "properties": {
        "issuer": { "type": "string" },
        "clientId": { "type": "string" },
        "clientSecret": { "type": "string" },
        "redirectUri": { "type": "string" },
        "providerLabel": { "type": "string" }
      },
      "if": { "required": ["issuer"], "properties": { "issuer": { "minLength": 1 } } },
      "then": {
        "required": ["clientId", "clientSecret", "redirectUri"],
        "properties": {
          "clientId": { "minLength": 1 },
          "clientSecret": { "minLength": 1 },
          "redirectUri": { "minLength": 1 }
        }
      }
    },
    "appSecrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "create": { "type": "boolean" }
      }
    },
    "internalCA": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "caKey": { "type": "string" },
        "mountFile": { "type": "string" }
      }
    },
    "resources": { "type": "object" },
    "securityContext": { "type": "object" },
    "migrationJob": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer" },
        "activeDeadlineSeconds": { "type": "integer" },
        "ttlSecondsAfterFinished": { "type": "integer" }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "serviceMetrics": { "type": "boolean" }
      }
    },
    "logging": {
      "type": "object",
      "properties": {
        "format": { "type": "string", "enum": ["json", "text"] }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" },
        "securityContext": { "type": "object" }
      }
    },
    "workerFreshness": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" },
        "securityContext": { "type": "object" }
      }
    },
    "workerEngine": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" },
        "securityContext": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": [ "integer", "string" ] }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "addresses": { "type": "array" },
        "listeners": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "protocol", "port"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "protocol": { "type": "string", "enum": ["HTTP", "HTTPS", "TCP", "TLS", "UDP"] },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "hostname": { "type": "string" },
              "allowedRoutes": { "type": "object" },
              "tls": { "type": "object" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "required": ["enabled"], "properties": { "enabled": { "const": true } } },
          "then": { "required": ["className"], "properties": { "className": { "minLength": 1 } } }
        }
      ]
    },
    "httproute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "gatewayName": { "type": "string" },
        "gatewayNamespace": { "type": "string" },
        "hosts": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
