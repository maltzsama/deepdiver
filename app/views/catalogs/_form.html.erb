<section class="panel">
  <div class="panel-body">
    <%= form_with model: catalog, class: "form-grid" do |form| %>
      <% if catalog.errors.any? %>
        <div class="errors">
          <p class="errors-title">
            <%= t("catalogs.form.errors_#{catalog.errors.count == 1 ? "one" : "other"}",
                  count: catalog.errors.count) %>
          </p>
          <ul class="errors-list">
            <% catalog.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="field">
        <%= form.label :name, t("catalogs.form.name"), class: "field-label" %>
        <p class="field-hint"><%= t("catalogs.form.name_hint") %></p>
        <%= form.text_field :name, class: "field-input", placeholder: t("catalogs.form.name_placeholder") %>
      </div>

      <div class="field">
        <%= form.label :trino_catalog_name, t("catalogs.form.trino_name"), class: "field-label" %>
        <p class="field-hint">
          <%= t("catalogs.form.trino_name_hint") %>
        </p>
        <%= form.text_field :trino_catalog_name, class: "field-input field-input-mono",
                            placeholder: t("catalogs.form.trino_name_placeholder") %>
      </div>

      <div class="field">
        <%= form.label :catalog_type, t("catalogs.form.type"), class: "field-label" %>
        <%= form.select :catalog_type, Catalog::CATALOG_TYPES, {}, class: "field-input" %>
      </div>

      <div class="field">
        <%= form.label :endpoint, t("catalogs.form.endpoint"), class: "field-label" %>
        <p class="field-hint"><%= t("catalogs.form.endpoint_hint") %></p>
        <%= form.url_field :endpoint, class: "field-input field-input-mono",
                           placeholder: t("catalogs.form.endpoint_placeholder") %>
      </div>

      <div class="field">
        <%= form.label :properties, t("catalogs.form.properties"), class: "field-label" %>
        <p class="field-hint"><%= t("catalogs.form.properties_hint") %></p>
        <%= form.text_area :properties, value: catalog.properties&.to_json, rows: 4,
                           class: "field-input field-input-mono",
                           placeholder: t("catalogs.form.properties_placeholder") %>
      </div>

      <div class="form-actions">
        <%= form.submit t("catalogs.form.submit"), class: "btn btn-primary" %>
        <%= link_to t("catalogs.form.cancel"), catalogs_path, class: "link text-sm" %>
      </div>
    <% end %>
  </div>
</section>