<section class="panel">
  <div class="panel-body">
    <%= form_with model: catalog, class: "form-grid" do |form| %>
      <% if catalog.errors.any? %>
        <div class="errors">
          <p class="errors-title">
            <%= t("catalogs.form.errors_#{catalog.errors.count == 1 ? "one" : "other"}",
                  count: catalog.errors.count) %>
          </p>
          <ul class="errors-list">
            <% catalog.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="field">
        <%= form.label :name, t("catalogs.form.name"), class: "field-label" %>
        <p class="field-hint"><%= t("catalogs.form.name_hint") %></p>
        <%= form.text_field :name, class: "field-input", placeholder: t("catalogs.form.name_placeholder") %>
      </div>

      <div class="field">
        <%= form.label :catalog_type, t("catalogs.form.type"), class: "field-label" %>
        <%= form.select :catalog_type, Catalog::CATALOG_TYPES, {}, class: "field-input" %>
      </div>

      <div class="field">
        <%= form.label :endpoint, t("catalogs.form.endpoint"), class: "field-label" %>
        <p class="field-hint"><%= t("catalogs.form.endpoint_hint") %></p>
        <%= form.url_field :endpoint, class: "field-input field-input-mono",
                           placeholder: t("catalogs.form.endpoint_placeholder") %>
      </div>

      <div class="field-group">
        <p class="field-group-title"><%= t("catalogs.form.auth") %></p>

        <%= form.fields_for :catalog_credential do |cf| %>
          <div class="field">
            <%= cf.label :auth_method, t("catalogs.form.auth_method"), class: "field-label" %>
            <%= cf.select :auth_method,
                          CatalogCredential::AUTH_METHODS.map { |m| [ t("catalogs.auth_methods.#{m}"), m ] },
                          {}, class: "field-input" %>
          </div>

          <div class="field">
            <%= cf.label :client_id, t("catalogs.form.client_id"), class: "field-label" %>
            <%= cf.text_field :client_id, class: "field-input field-input-mono" %>
          </div>

          <div class="field">
            <%= cf.label :secret, t("catalogs.form.client_secret"), class: "field-label" %>
            <% if cf.object&.secret_set? %>
              <p class="field-hint">
                <%= t("catalogs.form.secret_set_at",
                      when: l(cf.object.secret_set_at, format: :short),
                      hint: cf.object.secret_hint) %>
              </p>
            <% end %>
            <%= cf.password_field :secret, value: nil, autocomplete: "new-password",
                                  placeholder: cf.object&.secret_set? ? t("catalogs.form.secret_keep") : nil,
                                  class: "field-input field-input-mono" %>
            <p class="field-hint"><%= t("catalogs.form.secret_hint") %></p>
          </div>

          <div class="field">
            <%= cf.label :scope, t("catalogs.form.scope"), class: "field-label" %>
            <%= cf.text_field :scope, class: "field-input field-input-mono" %>
            <p class="field-hint">Polaris: <code class="font-mono">PRINCIPAL_ROLE:ALL</code></p>
          </div>
        <% end %>
      </div>

      <details class="field-group">
        <summary class="field-group-title cursor-pointer"><%= t("catalogs.form.advanced") %></summary>

        <div class="field mt-4">
          <%= form.label :trino_catalog_name_override, t("catalogs.form.trino_name"), class: "field-label" %>
          <p class="field-hint">
            <%= t("catalogs.form.trino_name_hint", derived: catalog.send(:derived_trino_catalog_name)) %>
          </p>
          <%= form.text_field :trino_catalog_name_override, class: "field-input field-input-mono",
                              placeholder: catalog.send(:derived_trino_catalog_name) %>
        </div>
      </details>

      <div class="form-actions">
        <%= form.submit t("catalogs.form.submit"), class: "btn btn-primary" %>
        <%= link_to t("catalogs.form.cancel"), catalogs_path, class: "link text-body" %>
      </div>
    <% end %>
  </div>
</section>