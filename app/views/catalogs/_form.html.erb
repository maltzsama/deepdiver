<%= form_with model: catalog, class: "schedule-form" do |form| %>
  <% if catalog.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(catalog.errors.count, "error") %> prevented this catalog from being saved:</h2>
      <ul>
        <% catalog.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :trino_catalog_name, "Trino catalog name" %>
    <p><small>Name of the catalog file in Trino's etc/catalog/&lt;name&gt;.properties</small></p>
    <%= form.text_field :trino_catalog_name %>
  </div>

  <div>
    <%= form.label :catalog_type %>
    <%= form.select :catalog_type, Catalog::CATALOG_TYPES %>
  </div>

  <div>
    <%= form.label :endpoint %>
    <%= form.url_field :endpoint %>
  </div>

  <div>
    <%= form.label :properties %>
    <p><small>JSON, e.g. {"bearerToken": "..."}</small></p>
    <%= form.text_area :properties, value: catalog.properties&.to_json %>
  </div>

  <%= form.submit %>
<% end %>