<h1><%= @catalog.name %> <small>(<%= @catalog.catalog_type %>)</small></h1>
<p><%= @catalog.endpoint %></p>

<% if current_user.admin? %>
  <div class="flex gap-2 my-4">
    <%= button_to "Sync now", sync_catalog_path(@catalog), method: :post %>
    <%= button_to "Delete catalog", catalog_path(@catalog), method: :delete,
                 data: { turbo_confirm: "Delete this catalog and its tables?" } %>
  </div>
<% end %>

<h2 class="text-xl font-semibold mt-6 mb-3">Tables</h2>
<table class="w-full border-collapse">
  <thead>
    <tr>
      <th class="text-left p-2 border-b border-gray-200 font-semibold">Table</th>
      <th class="text-left p-2 border-b border-gray-200 font-semibold">Score</th>
      <th class="text-left p-2 border-b border-gray-200 font-semibold">Status</th>
      <th class="text-left p-2 border-b border-gray-200 font-semibold">Last update</th>
      <th class="text-left p-2 border-b border-gray-200 font-semibold">Schedules</th>
    </tr>
  </thead>
  <tbody>
    <% @tables.each do |table| %>
      <tr>
        <td class="p-2 border-b border-gray-200"><%= link_to table.fully_qualified_name, table, class: "text-blue-600 hover:text-blue-800" %></td>
        <td class="p-2 border-b border-gray-200"><%= table.health_score %></td>
        <td class="p-2 border-b border-gray-200"><%= table.health_status %></td>
        <td class="p-2 border-b border-gray-200"><%= table.last_data_update&.presence ? table.last_data_update.to_fs(:db) : "&mdash;".html_safe %></td>
        <td class="p-2 border-b border-gray-200"><%= table.schedules_count %></td>
      </tr>
    <% end %>
  </tbody>
</table>