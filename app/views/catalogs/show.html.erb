<% content_for :title, "#{@catalog.name} — LakeDeepDiver" %>

<% if @open_error_count && @open_error_count.positive? %>
  <a href="<%= error_events_path(catalog_id: @catalog.id) %>"
     class="flash flash-alert mb-5 no-underline block">
    <%= t("error_events.catalog_banner", count: @open_error_count, catalog: @catalog.name) %>
  </a>
<% end %>

<div class="page-head">
  <div>
    <p class="page-eyebrow"><%= t("catalogs.show.eyebrow") %></p>
    <h1 class="page-title-mono"><%= @catalog.name %></h1>
    <p class="page-sub">
      <span class="badge badge-neutral"><%= @catalog.catalog_type %></span>
      <span class="ml-2 font-mono text-small"><%= @catalog.endpoint %></span>
    </p>
  </div>

  <% if current_user.admin? %>
    <div class="page-actions">
      <%= button_to t("catalogs.show.sync_now"), sync_catalog_path(@catalog), method: :post,
                    class: "btn btn-primary" %>
      <%= button_to t("catalogs.show.test_connection"), verify_catalog_path(@catalog), method: :post,
                    class: "btn btn-default" %>
      <%= link_to t("catalogs.show.edit"), edit_catalog_path(@catalog), class: "btn btn-default" %>
      <%= button_to t("catalogs.show.delete"), catalog_path(@catalog), method: :delete,
                    class: "btn btn-danger",
                    data: { turbo_confirm: t("catalogs.show.delete_confirm") } %>
    </div>
  <% end %>
</div>

<section class="panel">
  <div class="panel-head">
    <h2 class="panel-title"><%= t("catalogs.show.tables_title") %></h2>
    <span class="panel-note"><%= t("catalogs.show.subtitle_span", count: @tables.size) %></span>
    <%= link_to t("catalogs.show.include_inactive"),
                catalog_path(@catalog, inactive: params[:inactive].present? ? nil : "1"),
                class: "link text-small ml-auto" %>
  </div>

  <% if @tables.empty? %>
    <div class="empty">
      <p class="empty-title"><%= t("catalogs.show.empty_title") %></p>
      <p class="empty-hint"><%= t("catalogs.show.empty_hint") %></p>
    </div>
  <% else %>
    <div class="data-table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t("catalogs.show.col_table") %></th>
            <th><%= t("catalogs.show.col_health") %></th>
            <th><%= t("catalogs.show.col_status") %></th>
            <th><%= t("catalogs.show.col_last_write") %></th>
            <th><%= t("catalogs.show.col_schedules") %></th>
          </tr>
        </thead>
        <tbody>
          <% @tables.each do |table| %>
            <tr>
              <td>
                <%= link_to table.fully_qualified_name, table, class: "link-mono" %>
                <% unless table.active? %>
                  <span class="badge badge-mute ml-1"><%= t("catalogs.show.inactive") %></span>
                <% end %>
              </td>
              <td><%= render "shared/health", table: table %></td>
              <td>
                <span class="badge <%= health_badge_class(table.health_status) %>">
                  <span class="badge-dot"></span><%= table.health_status %>
                </span>
              </td>
              <td><%= timestamp(table.last_data_update) %></td>
              <td class="cell-num"><%= table.schedules_count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>