<% content_for :title, t("alert_channels.index.title") %>

<div class="page-head">
  <div>
    <p class="page-eyebrow"><%= t("alert_channels.index.eyebrow") %></p>
    <h1 class="page-title"><%= t("alert_channels.index.title") %></h1>
    <p class="page-sub"><%= t("alert_channels.index.subtitle") %></p>
  </div>
  <div class="page-actions">
    <%= link_to t("alert_channels.index.settings"), alert_settings_path, class: "btn btn-default" %>
    <%= link_to t("alert_channels.index.new"), new_alert_channel_path, class: "btn btn-primary" %>
  </div>
</div>

<section class="panel">
  <div class="data-table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t("alert_channels.index.col_name") %></th>
          <th><%= t("alert_channels.index.col_destination") %></th>
          <th><%= t("alert_channels.index.col_min_severity") %></th>
          <th><%= t("alert_channels.index.col_status") %></th>
          <th><span class="sr-only"><%= t("alert_channels.index.col_actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% @channels.each do |channel| %>
          <tr>
            <td class="cell-id"><%= link_to channel.name, channel %></td>
            <td class="cell-muted">
              <%= [channel.slack_channel.presence, channel.email_to.presence].compact.join(" · ") %>
            </td>
            <td class="cell-num"><%= channel.min_severity %></td>
            <td>
              <% if channel.enabled? %>
                <span class="badge badge-ok"><span class="badge-dot"></span><%= t("alert_channels.index.enabled") %></span>
              <% else %>
                <span class="badge badge-warn"><span class="badge-dot"></span><%= t("alert_channels.index.disabled") %></span>
              <% end %>
            </td>
            <td class="text-right whitespace-nowrap">
              <%= button_to t("alert_channels.index.test"), test_alert_channel_path(channel), method: :post,
                            class: "btn btn-default btn-sm" %>
              <%= link_to t("alert_channels.index.edit"), edit_alert_channel_path(channel), class: "btn btn-default btn-sm ml-1" %>
              <%= button_to t("alert_channels.index.delete"), channel, method: :delete,
                            class: "btn btn-danger btn-sm ml-1 inline-flex",
                            form: { class: "inline-block" },
                            data: { turbo_confirm: t("alert_channels.index.delete_confirm", name: channel.name) } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @channels.empty? %>
    <div class="empty">
      <p class="empty-title"><%= t("alert_channels.index.empty_title") %></p>
      <p class="empty-hint"><%= t("alert_channels.index.empty_hint") %></p>
    </div>
  <% end %>
</section>
