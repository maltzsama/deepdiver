<% content_for :title, "#{t("dashboard.index.title")} — LakeDeepDiver" %>

<div class="page-head">
  <div>
    <p class="page-eyebrow"><%= t("dashboard.index.eyebrow") %></p>
    <h1 class="page-title"><%= t("dashboard.index.title") %></h1>
    <p class="page-sub">
      <% if @last_sync_at %>
        <%= t("dashboard.index.sync_ago", ago: time_ago_in_words(@last_sync_at),
                                          at: @last_sync_at.to_fs(:db)) %>
      <% else %>
        <%= t("dashboard.index.sync_none") %>
      <% end %>
    </p>
  </div>
</div>

<%= render "shared/health_summary", counts: @health_counts, total: @total_tables %>

<div class="grid gap-6 lg:grid-cols-3">
  <section class="panel lg:col-span-2">
    <div class="panel-head">
      <h2 class="panel-title"><%= t("dashboard.index.worst_title") %></h2>
      <%= link_to t("dashboard.index.view_all_tables"), iceberg_tables_path, class: "link text-sm" %>
    </div>

    <% if @worst_health_tables.empty? %>
      <div class="empty">
        <p class="empty-title"><%= t("dashboard.index.worst_empty_title") %></p>
        <p class="empty-hint"><%= t("dashboard.index.worst_empty_hint") %></p>
        <div class="empty-action">
          <%= link_to t("dashboard.index.go_to_catalogs"), catalogs_path, class: "btn btn-primary" %>
        </div>
      </div>
    <% else %>
      <div class="data-table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th><%= t("dashboard.index.col_table") %></th>
              <th><%= t("dashboard.index.col_catalog") %></th>
              <th><%= t("dashboard.index.col_health") %></th>
              <th><%= t("dashboard.index.col_status") %></th>
              <th><%= t("dashboard.index.col_last_write") %></th>
            </tr>
          </thead>
          <tbody>
            <% @worst_health_tables.each do |table| %>
              <tr>
                <td><%= link_to table.fully_qualified_name, table, class: "link-mono" %></td>
                <td class="cell-muted"><%= table.catalog.name %></td>
                <td><%= render "shared/health", table: table %></td>
                <td>
                  <span class="badge <%= health_badge_class(table.health_status) %>">
                    <span class="badge-dot"></span><%= table.health_status %>
                  </span>
                </td>
                <td><%= timestamp(table.last_data_update) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>

  <div class="flex flex-col gap-6">
    <section class="panel">
      <div class="panel-head">
        <h2 class="panel-title"><%= t("dashboard.index.paused_title") %></h2>
        <% if @paused_schedules.any? %>
          <span class="badge badge-critical"><%= @paused_schedules.size %></span>
        <% end %>
      </div>

      <% if @paused_schedules.empty? %>
        <div class="empty">
          <p class="empty-title"><%= t("dashboard.index.paused_empty_title") %></p>
          <p class="empty-hint"><%= t("dashboard.index.paused_empty_hint") %></p>
        </div>
      <% else %>
        <ul class="divide-y divide-abyss-50">
          <% @paused_schedules.each do |schedule| %>
            <li class="px-4 py-3">
              <%= link_to schedule.iceberg_table.fully_qualified_name, schedule, class: "link-mono" %>
              <p class="mt-1 flex items-center gap-2 text-xs">
                <span class="badge badge-neutral"><%= schedule.operation %></span>
                <span class="font-mono text-critical-600">
                  <%= t("dashboard.index.failures", count: schedule.consecutive_failures) %>
                </span>
              </p>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2 class="panel-title"><%= t("dashboard.index.last_ops_title") %></h2>
        <%= link_to t("dashboard.index.view_all_ops"), execution_histories_path, class: "link text-sm" %>
      </div>

      <% if @recent_executions.empty? %>
        <div class="empty">
          <p class="empty-title"><%= t("dashboard.index.last_ops_empty_title") %></p>
        </div>
      <% else %>
        <ul class="divide-y divide-abyss-50">
          <% @recent_executions.each do |execution| %>
            <li class="flex items-center justify-between gap-3 px-4 py-2.5">
              <div class="min-w-0">
                <p class="truncate font-mono text-xs text-abyss-900">
                  <%= execution.iceberg_table.fully_qualified_name %>
                </p>
                <p class="cell-muted text-xs"><%= execution.operation_label %></p>
              </div>
              <span class="badge <%= execution_status_badge_class(execution.status) %>">
                <span class="badge-dot"></span><%= execution.status %>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>
</div>