<% content_for :title, "Overview — LakeDeepDiver" %>

<% if @open_error_count && @open_error_count.positive? %>
  <a href="<%= error_events_path %>"
     class="flash flash-alert mb-5 no-underline block">
    <%= t("error_events.overview_banner", count: @open_error_count) %>
  </a>
<% end %>

<div class="flex items-center justify-between mb-5 pb-3 border-b border-cosmos-line">
  <div>
    <p class="font-mono text-micro font-bold tracking-[0.2em] uppercase text-accent-DEFAULT">Control Plane</p>
    <h1 class="font-display text-2xl font-extrabold tracking-tight text-cosmos-fg">Overview</h1>
    <p class="text-body text-cosmos-fg-mute">
      <% if @last_sync_at %>
        Synced <%= time_ago_in_words(@last_sync_at) %> ago
      <% else %>
        No sync yet
      <% end %>
    </p>
  </div>
  <div class="flex items-center gap-3">
    <% if @cluster_name %>
      <span class="font-mono text-micro text-cosmos-fg-mute"><%= @cluster_name %></span>
    <% end %>
    <a href="<%= root_path %>" class="px-3 py-1.5 font-mono text-small font-semibold bg-cosmos-surface border border-cosmos-line text-cosmos-fg-soft hover:bg-cosmos-soft hover:text-cosmos-fg cursor-pointer no-underline">
      ↻ Refresh
    </a>
  </div>
</div>

<!-- Stats Cards -->
<% total = @total_tables || 0 %>
<% healthy = (@health_counts || {})["healthy"] || 0 %>
<% critical = (@health_counts || {})["critical"] || 0 %>
<% warning = (@health_counts || {})["warning"] || 0 %>
<div class="grid grid-cols-2 gap-px bg-cosmos-line border border-cosmos-line mb-5 md:grid-cols-3 lg:grid-cols-5">
  <%= render "shared/stat_card", label: "Tables", value: total, unit: "across all catalogs",
             track_pct: 100 %>
  <%= render "shared/stat_card", label: "Healthy", value: healthy,
             value_class: "text-ok-DEFAULT", fill_class: "bg-ok-DEFAULT",
             unit: "#{total.positive? ? (healthy.to_f / total * 100).round(1) : 0}% availability",
             track_pct: total.positive? ? (healthy.to_f / total * 100) : 0 %>
  <%= render "shared/stat_card", label: "Critical", value: critical,
             value_class: "text-red-DEFAULT", fill_class: "bg-red-DEFAULT",
             unit: "#{warning} warning",
             track_pct: total.positive? ? (critical.to_f / total * 100) : 0 %>
  <%= render "shared/stat_card", label: "Active Plans", value: MaintenancePlan.dispatchable.count,
             unit: "#{MaintenancePlan.where(is_paused: true).count} paused",
             track_pct: 100 %>
  <% late = @freshness_counts.fetch("late", 0) %>
  <% sla_total = @freshness_counts.values.sum %>
  <%= link_to execution_histories_path(kind: "freshness"), class: "block" do %>
    <%= render "shared/stat_card",
          label: t("dashboard.index.sla_card_label"),
          value: late,
          value_class: late.positive? ? "text-red-DEFAULT" : "text-ok-DEFAULT",
          fill_class: late.positive? ? "bg-red-DEFAULT" : "bg-ok-DEFAULT",
          unit: t("dashboard.index.sla_card_unit"),
          track_pct: sla_total.zero? ? 0 : (late.to_f / sla_total * 100) %>
  <% end %>
</div>

<!-- Precisa de acao -->
<div class="panel">
  <div class="panel-head">
    <h2 class="panel-title"><%= t("dashboard.index.triage_title") %></h2>
    <span class="panel-note">
      <% if @triage.any? %>
        <%= t("dashboard.index.triage_note", count: @triage.size) %>
      <% end %>
    </span>
  </div>

  <% if @triage.empty? %>
    <div class="panel-body text-center py-10">
      <p class="text-body text-cosmos-fg-soft"><%= t("dashboard.index.triage_empty_title") %></p>
      <p class="text-small text-cosmos-fg-mute mt-1"><%= t("dashboard.index.triage_empty_hint") %></p>
    </div>
  <% else %>
    <div class="panel-body p-0 data-table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t("dashboard.index.col_table") %></th>
            <th><%= t("dashboard.index.col_maintenance") %></th>
            <th><%= t("dashboard.index.col_freshness") %></th>
            <th><%= t("dashboard.index.col_since") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @triage.each do |row| %>
            <tr>
              <td class="cell-id">
                <%= link_to row.table.fully_qualified_name, row.table, class: "hover:underline" %>
                <span class="text-small text-cosmos-fg-mute ml-2"><%= row.table.catalog.name %></span>
              </td>

              <%# Coluna de manutenção — vermelha só se for esse o problema %>
              <td>
                <% if row.reasons.include?(:health) %>
                  <span class="badge badge-err">
                    <span class="badge-dot"></span><%= row.table.health_score %>
                  </span>
                <% elsif row.table.health_score %>
                  <span class="text-small text-cosmos-fg-mute"><%= row.table.health_score %></span>
                <% else %>
                  <span class="text-small text-cosmos-fg-mute">—</span>
                <% end %>
              </td>

              <%# Coluna de frescor %>
              <td>
                <% if row.reasons.include?(:freshness) %>
                  <span class="badge <%= row.sla.status == "late" ? "badge-err" : "badge-warn" %>">
                    <span class="badge-dot"></span>
                    <% if row.sla.breached_since %>
                      <%= distance_of_time_in_words(row.sla.breached_since, Time.current) %>
                    <% else %>
                      <%= t("freshness.status.#{row.sla.status}") %>
                    <% end %>
                  </span>
                <% elsif row.sla&.enabled? %>
                  <span class="text-small text-cosmos-fg-mute">on track</span>
                <% else %>
                  <span class="text-small text-cosmos-fg-mute">no SLA</span>
                <% end %>
              </td>

              <td class="cell-muted">
                <% if row.degraded_at %>
                  <%= distance_of_time_in_words(row.degraded_at, Time.current) %> ago
                <% else %>
                  <span class="text-cosmos-fg-mute">—</span>
                <% end %>
              </td>

              <td class="text-right">
                <% if row.reasons.include?(:health) && row.table.maintenance_plan && can_run_maintenance? %>
                  <%= button_to t("dashboard.index.run_now"),
                        run_maintenance_plan_path(row.table.maintenance_plan),
                        method: :post, class: "link text-small" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>