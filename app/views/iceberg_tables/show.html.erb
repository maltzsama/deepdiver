<h1 class="text-2xl font-bold"><%= @table.fully_qualified_name %></h1>
<p class="mb-4"><%= link_to @table.catalog.name, @table.catalog, class: "text-blue-600 hover:text-blue-800" %></p>

<dl class="my-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
  <dt class="font-semibold">Health score</dt>
  <dd><%= @table.health_score %></dd>
  <dt class="font-semibold">Health status</dt>
  <dd><%= @table.health_status %></dd>
  <dt class="font-semibold">Last data update</dt>
  <dd><%= @table.last_data_update&.presence ? @table.last_data_update.to_fs(:db) : "&mdash;".html_safe %></dd>
</dl>

<h2 class="text-xl font-semibold mt-6 mb-3">Schedules</h2>
<% if @schedules.empty? %>
  <p>No maintenance schedules for this table.</p>
<% else %>
  <table class="w-full border-collapse">
    <thead>
      <tr>
        <th class="text-left p-2 border-b border-gray-200 font-semibold">Operation</th>
        <th class="text-left p-2 border-b border-gray-200 font-semibold">Cron</th>
        <th class="text-left p-2 border-b border-gray-200 font-semibold">Paused</th>
        <th class="text-left p-2 border-b border-gray-200 font-semibold">Failures</th>
        <% if current_user.admin? %>
          <th class="text-left p-2 border-b border-gray-200 font-semibold" colspan="2"></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @schedules.each do |schedule| %>
        <tr>
          <td class="p-2 border-b border-gray-200"><%= schedule.operation %></td>
          <td class="p-2 border-b border-gray-200"><%= schedule.cron %></td>
          <td class="p-2 border-b border-gray-200"><%= schedule.paused? ? "yes" : "no" %></td>
          <td class="p-2 border-b border-gray-200"><%= schedule.consecutive_failures %></td>
          <% if current_user.admin? %>
            <td class="p-2 border-b border-gray-200"><%= link_to "View", maintenance_schedule_path(schedule), class: "text-blue-600 hover:text-blue-800" %></td>
            <td class="p-2 border-b border-gray-200"><%= button_to "Delete", maintenance_schedule_path(schedule), method: :delete,
                              data: { turbo_confirm: "Delete this schedule?" } %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if current_user.admin? %>
  <div class="flex gap-2 my-4">
    <%= link_to "New schedule", new_maintenance_schedule_path(iceberg_table_id: @table.id), class: "text-blue-600 hover:text-blue-800" %>
    <%= button_to "Run maintenance now", run_maintenance_iceberg_table_path(@table), method: :post %>
  </div>
<% end %>

<h2 class="text-xl font-semibold mt-6 mb-3">Recent executions</h2>
<table class="w-full border-collapse">
  <thead>
    <tr>
      <th class="text-left p-2 border-b border-gray-200 font-semibold">Status</th>
      <th class="text-left p-2 border-b border-gray-200 font-semibold">Step</th>
      <th class="text-left p-2 border-b border-gray-200 font-semibold">Retries</th>
      <th class="text-left p-2 border-b border-gray-200 font-semibold">Error</th>
      <th class="text-left p-2 border-b border-gray-200 font-semibold">Ran at</th>
    </tr>
  </thead>
  <tbody>
    <% @executions.each do |execution| %>
      <tr>
        <td class="p-2 border-b border-gray-200"><%= execution.status %></td>
        <td class="p-2 border-b border-gray-200"><%= execution.current_step %></td>
        <td class="p-2 border-b border-gray-200"><%= execution.retry_count %></td>
        <td class="p-2 border-b border-gray-200"><%= execution.error_message %></td>
        <td class="p-2 border-b border-gray-200"><%= execution.created_at.to_fs(:db) %></td>
      </tr>
    <% end %>
    <% if @executions.empty? %>
      <tr><td colspan="5" class="p-2 border-b border-gray-200">No executions yet.</td></tr>
    <% end %>
  </tbody>
</table>