<% content_for :title, "#{@table.fully_qualified_name} — LakeDeepDiver" %>

<div class="page-head">
  <div>
    <p class="page-eyebrow">
      <%= t("tables.show.eyebrow_prefix") %>
      <%= link_to @table.catalog.name, @table.catalog, class: "link" %>
    </p>
    <h1 class="page-title-mono"><%= @table.fully_qualified_name %></h1>
  </div>

  <div class="page-actions">
    <% if can_run_maintenance? %>
      <%= button_to t("tables.show.run_now"),
                    run_maintenance_iceberg_table_path(@table), method: :post,
                    class: "btn btn-primary" %>
    <% end %>
    <% if current_user.admin? %>
      <%= link_to t("tables.show.new_schedule"),
                  new_maintenance_schedule_path(iceberg_table_id: @table.id),
                  class: "btn btn-default" %>
    <% end %>
  </div>
</div>

<section class="panel mb-6">
  <div class="panel-body">
    <dl class="dl">
      <div>
        <dt class="dl-term"><%= t("tables.show.score") %></dt>
        <dd class="dl-desc"><%= render "shared/health", table: @table %></dd>
      </div>
      <div>
        <dt class="dl-term"><%= t("tables.show.status") %></dt>
        <dd class="dl-desc">
          <span class="badge <%= health_badge_class(@table.health_status) %>">
            <span class="badge-dot"></span><%= @table.health_status %>
          </span>
        </dd>
      </div>
      <div>
        <dt class="dl-term"><%= t("tables.show.last_write") %></dt>
        <dd class="dl-desc-mono"><%= timestamp(@table.last_data_update) %></dd>
      </div>
      <div>
        <dt class="dl-term"><%= t("tables.show.trino_id") %></dt>
        <dd class="dl-desc-mono text-xs"><%= @table.trino_identifier %></dd>
      </div>
    </dl>
  </div>
</section>

<section class="panel mb-6">
  <div class="panel-head">
    <h2 class="panel-title"><%= t("tables.show.schedules_title") %></h2>
    <span class="panel-note"><%= t("tables.show.schedules_note",
                                   count: @schedules.size,
                                   total: MaintenanceSchedule::OPERATIONS.size) %></span>
  </div>

  <% if @schedules.empty? %>
    <div class="empty">
      <p class="empty-title"><%= t("tables.show.empty_title") %></p>
      <p class="empty-hint"><%= t("tables.show.empty_hint") %></p>
      <% if current_user.admin? %>
        <div class="empty-action">
          <%= link_to t("tables.show.create_schedule"),
                      new_maintenance_schedule_path(iceberg_table_id: @table.id),
                      class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="data-table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t("tables.show.col_operation") %></th>
            <th><%= t("tables.show.col_cron") %></th>
            <th><%= t("tables.show.col_state") %></th>
            <th><%= t("tables.show.col_failures") %></th>
            <% if current_user.admin? %>
              <th><span class="sr-only"><%= t("tables.show.col_actions") %></span></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @schedules.each do |schedule| %>
            <tr>
              <td><%= link_to schedule.operation, schedule, class: "link-mono" %></td>
              <td class="cell-id"><%= schedule.cron %></td>
              <td>
                <% if schedule.paused? %>
                  <span class="badge badge-critical"><span class="badge-dot"></span><%= t("tables.show.paused") %></span>
                <% else %>
                  <span class="badge badge-healthy"><span class="badge-dot"></span><%= t("tables.show.active") %></span>
                <% end %>
              </td>
              <td class="cell-num"><%= schedule.consecutive_failures %></td>
              <% if current_user.admin? %>
                <td class="text-right whitespace-nowrap">
                  <%= link_to t("tables.show.open"), maintenance_schedule_path(schedule),
                              class: "btn btn-default btn-sm" %>
                  <%= button_to t("tables.show.delete"), maintenance_schedule_path(schedule),
                                method: :delete,
                                class: "btn btn-danger btn-sm ml-1 inline-flex",
                                form: { class: "inline-block" },
                                data: { turbo_confirm: t("tables.show.delete_confirm") } %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>

<%= render "metadata_tabs", table: @table %>

<%= render "freshness", table: @table %>

<%= render "shared/executions", executions: @executions %>