<% content_for :title, "#{@table.fully_qualified_name} — DeepDiver" %>

<% if @open_error_count&.positive? &&
      !(session[:dismissed_error_banners] || []).include?(@table.id) %>
  <div class="flash flash-alert mb-5 flex items-center gap-3">
    <p class="flex-1" role="alert">
      <% dominant_op, dominant_count = @open_error_groups.max_by { |_op, count| count } %>
      <%= t("error_events.table_banner", count: @open_error_count) %>
      <% if dominant_op %>
        <span class="text-cosmos-fg-soft">— <%= t("error_events.table_banner_kind", operation: dominant_op, count: dominant_count) %></span>
      <% end %>
      <%= link_to t("error_events.table_banner_link"),
                  execution_histories_path(table_id: @table.id),
                  class: "link text-body underline" %>
    </p>
    <%= button_to t("error_events.table_banner_dismiss"),
                  dismiss_errors_iceberg_table_path(@table), method: :post,
                  class: "btn btn-default btn-sm",
                  data: { turbo_submits_with: t("actions.sending") } %>
  </div>
<% end %>

<div class="page-head">
  <div>
    <p class="page-eyebrow">
      <%= t("tables.show.eyebrow_prefix") %>
      <%= link_to @table.catalog.name, @table.catalog, class: "link" %>
    </p>
    <h1 class="page-title-mono"><%= @table.fully_qualified_name %></h1>
  </div>

  <div class="page-actions">
    <% if can_run_maintenance? %>
      <%= button_to t("tables.show.run_now"),
                    run_maintenance_iceberg_table_path(@table), method: :post,
                    class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

<%= render "shared/health_breakdown", evaluation: @evaluation %>

<%= render "maintenance_impact", table: @table %>

<section class="panel mb-6">
  <div class="panel-body">
    <dl class="dl">
      <div>
        <dt class="dl-term"><%= t("tables.show.status") %></dt>
        <dd class="dl-desc">
          <span class="badge <%= health_badge_class(@table.health_status) %>">
            <span class="badge-dot"></span><%= @table.health_status %>
          </span>
        </dd>
      </div>
      <div>
        <dt class="dl-term"><%= t("tables.show.last_write") %></dt>
        <dd class="dl-desc-mono"><%= timestamp(@table.last_data_update) %></dd>
      </div>
      <div>
        <dt class="dl-term"><%= t("tables.show.trino_id") %></dt>
        <dd class="dl-desc-mono text-small"><%= @table.trino_identifier %></dd>
      </div>
    </dl>
  </div>
</section>

<%= render "metadata_tabs", table: @table %>

<%= render "freshness", table: @table %>

<%= render "shared/executions", executions: @executions %>