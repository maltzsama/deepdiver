<% content_for :title, "#{t("tables.index.title")} — DeepDiver" %>

<div class="page-head">
  <div>
    <p class="page-eyebrow"><%= t("tables.index.eyebrow") %></p>
    <h1 class="page-title"><%= t("tables.index.title") %></h1>
    <p class="page-sub">
      <%= @last_sync_at ? t("tables.index.synced_ago", time: time_ago_in_words(@last_sync_at)) : t("tables.index.not_synced") %>
    </p>
  </div>
  <% if current_user.admin? %>
    <div class="page-actions">
      <%= link_to t("tables.index.sync_catalog"), catalogs_path, class: "btn btn-default" %>
    </div>
  <% end %>
</div>

<%= render "shared/filters",
           url: iceberg_tables_path,
           search: true,
           fields: [
             { name: :catalog_id, label: t("tables.filter_catalog"),
               options: @catalogs.map { |c| [ c.name, c.id ] } },
             { name: :namespace, label: t("tables.filter_namespace"),
               options: @namespaces.map { |n| [ n, n ] } },
             { name: :health_status, label: t("tables.filter_status"),
               options: IcebergTable::HEALTH_STATUSES.map { |s| [ s, s ] } },
             { name: :no_plan, label: t("tables.filter_no_plan"),
               options: [ [ t("tables.index.no_plan_option"), "1" ] ] },
             { name: :freshness, label: t("tables.filter_freshness"),
               options: [ [ t("tables.fresh_late_filter"), "late" ],
                          [ t("tables.fresh_no_sla_filter"), "no_sla" ],
                          [ t("tables.fresh_error_filter"), "error" ] ] }
           ],
           checkbox: { name: :inactive, label: t("tables.index.include_inactive") } %>

<section class="panel">
  <div class="panel-head">
    <h2 class="panel-title"><%= t("tables.index.result") %></h2>
    <span class="panel-note"><%= t("tables.index.count", count: @tables.length) %></span>
  </div>

  <% if @tables.empty? %>
    <div class="empty">
      <p class="empty-title"><%= t("tables.index.empty_title") %></p>
      <p class="empty-hint">
        <% if request.query_parameters.any? %>
          <%= t("tables.index.empty_filters_hint") %>
        <% else %>
          <%= t("tables.index.empty_none_hint") %>
        <% end %>
      </p>
    </div>
  <% else %>
  <% if @tables.any? && can_run_maintenance? %>
    <div class="panel-body border-b border-cosmos-line">
      <%= form_with url: bulk_apply_maintenance_policies_path, method: :post, class: "flex items-center gap-3" do |f| %>
        <%= f.select :policy_id,
                     MaintenancePolicy.order(:name).map { |p| [p.name, p.id] },
                     { prompt: t("tables.index.select_policy") },
                     class: "field-input field-input-sm" %>
        <button type="submit" class="btn btn-primary btn-sm"><%= t("tables.index.apply_policy") %></button>
        <span class="text-small cell-muted" id="bulk-count"></span>
      <% end %>
    </div>
  <% end %>

  <div class="data-table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <% if can_run_maintenance? %>
            <th scope="col" class="w-8">
              <input type="checkbox" id="select-all" class="field-checkbox">
            </th>
          <% end %>
          <th scope="col"><%= t("tables.index.col_table") %></th>
            <th scope="col"><%= t("tables.index.col_catalog") %></th>
            <th scope="col"><%= t("tables.index.col_health") %></th>
            <th scope="col"><%= t("tables.index.col_files") %></th>
            <th scope="col"><%= t("tables.index.col_avg_size") %></th>
            <th scope="col"><%= t("tables.index.col_records") %></th>
            <th scope="col"><%= t("tables.index.col_snapshots") %></th>
            <th scope="col"><%= t("tables.index.col_plan") %></th>
            <th scope="col"><%= t("tables.index.col_freshness") %></th>
            <th scope="col"><%= t("tables.index.col_last_write") %></th>
            <% if can_run_maintenance? %>
              <th scope="col"><span class="sr-only"><%= t("tables.index.col_actions") %></span></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @tables.each do |table| %>
            <tr>
              <% if can_run_maintenance? %>
                <td class="text-center">
                  <input type="checkbox" name="iceberg_table_ids[]" value="<%= table.id %>"
                         class="field-checkbox table-select">
                </td>
              <% end %>
              <td>
                <%= link_to table.fully_qualified_name, table, class: "link-mono" %>
                <% unless table.active? %>
                  <span class="badge badge-mute ml-1"><%= t("tables.index.inactive") %></span>
                <% end %>
              </td>
              <td class="cell-muted"><%= table.catalog.name %></td>
              <td title="<%= table_health_tooltip(table) %>">
                <span class="badge <%= health_badge_class(table.health_status) %>">
                  <span class="badge-dot"></span><%= table.health_status %>
                </span>
                <span class="ml-1 font-mono text-small text-cosmos-fg-soft"><%= table.health_score %></span>
              </td>
              <td class="cell-num"><%= table.total_data_files || "—" %></td>
              <td class="cell-num"><%= table.average_file_size ? number_to_human_size(table.average_file_size) : "—" %></td>
              <td class="cell-num"><%= table.total_records ? number_to_human(table.total_records) : "—" %></td>
              <td class="cell-num"><%= table.snapshot_count || "—" %></td>
              <td>
                <% if (plan = table.maintenance_plan) %>
                  <%= link_to t("tables.index.plan_link"), plan, class: "badge badge-neutral" %>
                <% else %>
                  <%= link_to t("tables.index.create_plan"),
                              new_maintenance_plan_path(maintenance_plan: { iceberg_table_id: table.id }),
                              class: "badge badge-warning" %>
                <% end %>
              </td>
              <td>
                <% freshness = freshness_label(table) %>
                <% if table.table_freshness_sla.nil? || !table.table_freshness_sla.enabled %>
                  <%= link_to edit_iceberg_table_freshness_sla_path(table),
                              class: "badge badge-mute no-underline hover:text-cosmos-fg",
                              title: t("tables.fresh_configure_title") do %>
                    <span class="badge-dot"></span><%= freshness[0] %>
                  <% end %>
                <% else %>
                  <span class="badge <%= freshness[1] %>"><span class="badge-dot"></span><%= freshness[0] %></span>
                <% end %>
              </td>
              <td><%= timestamp(table.last_data_update) %></td>
              <% if can_run_maintenance? %>
                <td class="text-right whitespace-nowrap">
                  <span class="inline-flex items-center gap-2">
                    <%= button_to t("tables.index.sync_table"), sync_table_iceberg_table_path(table),
                                  method: :post, class: "btn btn-default btn-sm" %>
                    <%= button_to t("tables.index.run"), run_maintenance_iceberg_table_path(table),
                                  method: :post, class: "btn btn-primary btn-sm" %>
                  </span>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>

<%== pager_nav(@pagy) %>