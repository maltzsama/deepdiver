<% content_for :title, "#{t("auth.passwords.new_title")} — #{t("auth.brand")}" %>

<div class="mx-auto max-w-sm">
  <div class="page-head">
    <div>
      <p class="page-eyebrow"><%= t("auth.brand") %></p>
      <h1 class="page-title"><%= t("auth.passwords.new_title") %></h1>
      <p class="page-sub"><%= t("auth.passwords.new_hint") %></p>
    </div>
  </div>

  <section class="panel">
    <div class="panel-body">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name),
                   html: { method: :post, class: "form-grid" }) do |f| %>
        <div class="field">
          <%= f.label :email, t("auth.passwords.new_label"), class: "field-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                            class: "field-input" %>
        </div>

        <div class="form-actions">
          <%= f.submit t("auth.passwords.new_title"), class: "btn btn-primary",
                      data: { turbo_submits_with: t("actions.sending") } %>
          <%= link_to t("auth.sign_in.forgot"), new_session_path(resource_name),
                      class: "link text-body" %>
        </div>
      <% end %>
    </div>
  </section>
</div>