<% content_for :title, "#{t("auth.account.edit_title")} — #{t("auth.brand")}" %>

<div class="mx-auto max-w-sm">
  <div class="page-head">
    <div>
      <p class="page-eyebrow"><%= t("auth.brand") %></p>
      <h1 class="page-title"><%= t("auth.account.edit_title") %></h1>
    </div>
  </div>

  <section class="panel">
    <div class="panel-body">
      <%= form_for(resource, as: resource_name, url: user_registration_path(resource_name),
                   html: { method: :put, class: "form-grid" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="field">
          <%= f.label :email, t("auth.fields.email"), class: "field-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                            class: "field-input" %>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="field-hint">
            <%= t("auth.account.waiting_confirmation", email: resource.unconfirmed_email) %>
          </p>
        <% end %>

        <div class="field">
          <%= f.label :password, t("auth.account.new_password_blank"), class: "field-label" %>
          <%= f.password_field :password, autocomplete: "new-password",
                               class: "field-input" %>
        </div>

        <div class="field">
          <%= f.label :password_confirmation, t("auth.account.confirm_password"),
                      class: "field-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                               class: "field-input" %>
        </div>

        <div class="field">
          <%= f.label :current_password, t("auth.account.current_password"), class: "field-label" %>
          <%= f.password_field :current_password, autocomplete: "current-password",
                               class: "field-input" %>
        </div>

        <div class="form-actions">
          <%= f.submit t("auth.account.update"), class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </section>
</div>