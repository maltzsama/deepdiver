<%# Shared: explained health score.
    Expects: evaluation (HealthEvaluator result hash, persisted or fresh) %>
<section class="panel mb-6">
  <div class="panel-head">
    <h2 class="panel-title"><%= t("health.title") %></h2>
    <% if evaluation[:coverage] %>
      <span class="panel-note"><%= t("health.coverage", coverage: evaluation[:coverage]) %></span>
    <% end %>
  </div>
  <div class="panel-body">
    <div class="mb-4 flex items-center gap-3">
      <% if evaluation[:score] %>
        <span class="font-display text-4xl font-bold text-cosmos-fg"><%= evaluation[:score] %></span>
        <span class="badge <%= health_badge_class(evaluation[:status]) %>">
          <span class="badge-dot"></span><%= t("health.status.#{evaluation[:status]}") %>
        </span>
        <% if evaluation[:worst_component] && evaluation[:worst_ratio].to_f < 0.5 %>
          <span class="text-small text-cosmos-fg-mute">
            <%= t("health.worst", component: t("health.component_labels.#{evaluation[:worst_component]}")) %>
          </span>
        <% end %>
      <% else %>
        <span class="font-display text-2xl text-cosmos-fg-mute"><%= t("health.no_score") %></span>
      <% end %>
    </div>

    <%# Every row renders the SAME four grid cells - label, track, percentage,
        detail - whether or not it has data. The bar/percentage/detail block
        used to live inside a has_data branch, so a row without data occupied a
        different amount of horizontal space and the columns shifted between
        rows; the track was also flex-1 inside a variable-width container, so
        tracks were not a consistent length. The track now has its own explicit
        grid column. %>
    <div class="space-y-2.5">
      <% health_component_rows(evaluation).each do |row| %>
        <div class="grid grid-cols-[8rem_minmax(0,1fr)_2.75rem_auto] items-center gap-3 text-body">
          <span class="text-cosmos-fg-soft" title="<%= row[:explains] %>"><%= row[:label] %></span>

          <div class="h-1.5 overflow-hidden rounded-full bg-cosmos-line">
            <div class="h-full rounded-full <%= severity_fill_class(row[:severity]) %>"
                 style="width: <%= row[:has_data] ? row[:pct] : 0 %>%"></div>
          </div>

          <% if row[:has_data] %>
            <span class="text-right font-mono text-small tabular-nums text-cosmos-fg-soft"><%= row[:pct] %>%</span>
            <span class="max-w-56 justify-self-end text-right text-small text-cosmos-fg-mute">
              <%= row[:detail] %>
              <span class="text-accent-DEFAULT">→ <%= row[:operation] %></span>
            </span>
          <% else %>
            <span class="text-right font-mono text-small tabular-nums text-cosmos-fg-mute">—</span>
            <span class="max-w-56 justify-self-end text-right text-small italic text-cosmos-fg-mute"
                  title="<%= t("health.component_missing", component: row[:label]) %>">
              <%= t("health.component_no_data") %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>

    <p class="mt-4 border-t border-cosmos-line pt-3 text-small text-cosmos-fg-mute">
      <%= t("health.footer") %>
    </p>
  </div>
</section>
