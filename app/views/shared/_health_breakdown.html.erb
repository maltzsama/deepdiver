<%# Shared: explained health score.
    Expects: evaluation (HealthEvaluator result hash), extractor (TableMetadataExtractor) %>
<section class="panel mb-6">
  <div class="panel-head">
    <h2 class="panel-title"><%= t("health.title") %></h2>
    <% if evaluation[:coverage] %>
      <span class="panel-note"><%= t("health.coverage", coverage: evaluation[:coverage]) %></span>
    <% end %>
  </div>
  <div class="panel-body">
    <div class="mb-4 flex items-baseline gap-3">
      <% if evaluation[:score] %>
        <span class="font-display text-4xl font-bold text-cosmos-fg"><%= evaluation[:score] %></span>
        <span class="badge <%= health_badge_class(evaluation[:status]) %>">
          <span class="badge-dot"></span><%= t("health.status.#{evaluation[:status]}") %>
        </span>
      <% else %>
        <span class="font-display text-2xl text-cosmos-fg-mute"><%= t("health.no_score") %></span>
      <% end %>
    </div>

    <div class="space-y-2.5">
      <% health_component_rows(evaluation, extractor).each do |row| %>
        <div class="grid grid-cols-[8rem_minmax(0,1fr)_auto] items-center gap-3 text-sm">
          <span class="text-cosmos-fg-soft" title="<%= row[:explains] %>"><%= row[:label] %></span>

          <% if row[:has_data] %>
            <div class="flex items-center gap-2">
              <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-cosmos-line">
                <div class="h-full rounded-full <%= severity_fill_class(row[:severity]) %>"
                     style="width: <%= row[:pct] %>%"></div>
              </div>
              <span class="w-9 text-right font-mono text-xs tabular-nums text-cosmos-fg-soft"><%= row[:pct] %>%</span>
            </div>
            <span class="max-w-56 justify-self-end text-right text-xs text-cosmos-fg-mute">
              <%= row[:detail] %>
              <span class="text-red-DEFAULT">→ <%= row[:operation] %></span>
            </span>
          <% else %>
            <span class="text-xs italic text-cosmos-fg-mute"><%= t("health.component_no_data") %></span>
            <span class="justify-self-end text-right text-xs text-cosmos-fg-mute">
              <%= t("health.component_missing", component: row[:label]) %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>

    <p class="mt-4 border-t border-cosmos-line pt-3 text-xs text-cosmos-fg-mute">
      <%= t("health.footer") %>
    </p>
  </div>
</section>
