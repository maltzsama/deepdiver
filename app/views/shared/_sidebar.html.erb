<aside class="sidebar col-start-1 row-span-2 bg-[#050504] border-r border-cosmos-line flex flex-col overflow-hidden"
       data-controller="sidebar">

  <!-- Logo e Nome -->
  <div class="sidebar-brand h-14 min-h-14 flex items-center px-3.5 gap-2.5 border-b border-cosmos-line flex-shrink-0">
    <img src="/icon.svg?v=3" width="32" height="32" alt="DeepDiver" class="flex-shrink-0">
    <span class="font-display font-extrabold text-base tracking-[0.04em] uppercase text-[#F4F1E8] whitespace-nowrap"><%= t("layout.app_name") %></span>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 overflow-y-auto overflow-x-hidden pb-2">
    <% # Section 1 %>
    <div class="sidebar-section">
      <div class="sidebar-section-title"><%= t("layout.nav.monitor") %></div>
      <%= nav_link_to root_path, icon: "grid" do %><span><%= t("layout.nav.overview") %></span><% end %>
      <%= nav_link_to activity_path, icon: "activity" do %><span><%= t("layout.nav.in_progress") %></span><% end %>
    </div>

    <% # Section 2 %>
    <div class="sidebar-section">
      <div class="sidebar-section-title"><%= t("layout.nav.data") %></div>
      <%= nav_link_to iceberg_tables_path, icon: "database" do %>
        <span><%= t("layout.nav.tables") %></span>
        <span class="sidebar-badge"><%= compact_number(IcebergTable.active.count) %></span>
      <% end %>
      <%= nav_link_to catalogs_path, icon: "catalog" do %>
        <span><%= t("layout.nav.catalogs") %></span>
        <span class="sidebar-badge"><%= compact_number(Catalog.count) %></span>
      <% end %>
    </div>

    <% # Section 3 %>
    <div class="sidebar-section">
      <div class="sidebar-section-title"><%= t("layout.nav.operations") %></div>
      <%= nav_link_to maintenance_plans_path, icon: "clock" do %>
        <span><%= t("layout.nav.plans") %></span>
        <span class="sidebar-badge"><%= compact_number(MaintenancePlan.count) %></span>
      <% end %>
      <%= nav_link_to maintenance_policies_path, icon: "preset" do %><span><%= t("layout.nav.policies") %></span><% end %>
      <%= nav_link_to execution_histories_path, icon: "list" do %>
        <span><%= t("layout.nav.history") %></span>
        <% open_freshness = ErrorEvent.open.where(operation: ErrorEvent::FRESHNESS_OPERATION).count %>
        <% if open_freshness.positive? %>
          <span class="sidebar-badge"><%= compact_number(open_freshness) %></span>
        <% end %>
      <% end %>
    </div>

    <% if current_user.admin? %>
      <div class="sidebar-section">
        <div class="sidebar-section-title"><%= t("layout.nav.security") %></div>
        <%= nav_link_to users_path, icon: "user" do %><span><%= t("layout.nav.users") %></span><% end %>
        <%= nav_link_to teams_path, icon: "team" do %><span><%= t("layout.nav.teams") %></span><% end %>
        <%= nav_link_to alert_settings_path, icon: "bell" do %><span><%= t("layout.nav.alerts") %></span><% end %>
        <%= nav_link_to trino_engine_config_path, icon: "settings" do %><span><%= t("layout.nav.engine") %></span><% end %>
      </div>
    <% end %>
  </nav>

  <!-- Sidebar footer -->
  <div class="border-t border-cosmos-line p-3 flex items-center justify-center flex-shrink-0 min-h-11">
    <button class="sidebar-collapse" title="<%= t("layout.nav.collapse") %>" data-sidebar-target="collapse"
            aria-label="<%= t("layout.nav.collapse") %>"
            aria-expanded="true"
            data-action="click->sidebar#toggle">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
        <path d="M10 3l-5 5 5 5" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </button>
  </div>
</aside>