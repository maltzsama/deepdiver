<aside class="sidebar col-start-1 row-span-2 bg-[#050504] border-r border-cosmos-line flex flex-col overflow-hidden">

  <!-- Logo e Nome -->
  <div class="h-12 min-h-12 flex items-center px-3.5 gap-2.5 border-b border-cosmos-line flex-shrink-0">
    <svg width="24" height="24" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="flex-shrink-0">
      <ellipse cx="20" cy="20" rx="18" ry="7" transform="rotate(-22 20 20)" stroke="#C8102E" stroke-width="2"/>
      <circle cx="20" cy="20" r="8" fill="#F4F1E8"/>
      <circle cx="20" cy="20" r="8" stroke="#0B0B0A" stroke-width="1.5"/>
      <circle cx="36" cy="14" r="2.2" fill="#C8102E"/>
      <circle cx="6"  cy="26" r="1.8" fill="#B8862A"/>
      <circle cx="14" cy="6"  r="1.4" fill="#B8862A"/>
    </svg>
    <span class="font-display font-extrabold text-sm tracking-[0.04em] uppercase text-[#F4F1E8] whitespace-nowrap">LakeDeepDiver</span>
  </div>

  <!-- Navegação -->
  <nav class="flex-1 overflow-y-auto overflow-x-hidden pb-2">
    <% # Seção 1 %>
    <div class="sidebar-section">
      <div class="sidebar-section-title">Monitor</div>
      <%= nav_link_to root_path, icon: "grid" do %><span>Overview</span><% end %>
      <%= nav_link_to activity_path, icon: "activity" do %><span>In Progress</span><% end %>
    </div>

    <% # Seção 2 %>
    <div class="sidebar-section">
      <div class="sidebar-section-title">Data</div>
      <%= nav_link_to iceberg_tables_path, icon: "database" do %>
        <span>Tables</span>
        <span class="sidebar-badge"><%= compact_number(IcebergTable.count) %></span>
      <% end %>
      <%= nav_link_to catalogs_path, icon: "catalog" do %>
        <span>Catalogs</span>
        <span class="sidebar-badge"><%= compact_number(Catalog.count) %></span>
      <% end %>
    </div>

    <% # Seção 3 %>
    <div class="sidebar-section">
      <div class="sidebar-section-title">Operations</div>
      <%= nav_link_to maintenance_plans_path, icon: "clock" do %>
        <span>Plans</span>
        <span class="sidebar-badge"><%= compact_number(MaintenancePlan.count) %></span>
      <% end %>
      <%= nav_link_to maintenance_policies_path, icon: "preset" do %><span>Policies</span><% end %>
      <%= nav_link_to execution_histories_path, icon: "list" do %><span>History</span><% end %>
      <% open_errors = ErrorEvent.open.count %>
      <%= nav_link_to error_events_path, icon: "activity" do %>
        <span>Errors</span>
        <% if open_errors.positive? %>
          <span class="sidebar-badge"><%= compact_number(open_errors) %></span>
        <% end %>
      <% end %>
    </div>

    <% if current_user.admin? %>
      <div class="sidebar-section">
        <div class="sidebar-section-title">Security</div>
        <%= nav_link_to users_path, icon: "user" do %><span>Users</span><% end %>
        <%= nav_link_to teams_path, icon: "team" do %><span>Teams</span><% end %>
      </div>
    <% end %>
  </nav>

  <!-- Rodapé da Sidebar -->
  <div class="border-t border-cosmos-line p-3 flex items-center justify-center flex-shrink-0 min-h-11">
    <button class="sidebar-collapse" title="Collapse sidebar" onclick="this.closest('.sidebar').classList.toggle('collapsed')">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
        <path d="M10 3l-5 5 5 5" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </button>
  </div>
</aside>

<!-- Estilos exclusivos da Sidebar -->
<style>
  .sidebar::-webkit-scrollbar { width: 4px; }
  .sidebar::-webkit-scrollbar-track { background: transparent; }
  .sidebar::-webkit-scrollbar-thumb { background: #2A2A28; }

  .sidebar-section { padding: 4px 0; }
  .sidebar-section-title {
    padding: 12px 14px 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #4A4640;
    border-top: 1px solid #1A1A18;
    margin-top: 6px;
    white-space: nowrap;
  }
  .sidebar-section:first-child .sidebar-section-title { border-top: none; margin-top: 0; }

  .sidebar-link {
    display: flex; align-items: center; gap: 10px;
    padding: 7px 14px; color: #8A857A; text-decoration: none;
    font-size: 12.5px; font-weight: 500;
    border-left: 2px solid transparent;
    white-space: nowrap; overflow: hidden;
  }
  .sidebar-link:hover { background: #1A1A18; color: #F4F1E8; }
  .sidebar-link.active {
    background: #C8102E; color: #F4F1E8;
    border-left-color: #F4F1E8; font-weight: 600;
  }
  .sidebar-link .icon { flex-shrink: 0; opacity: 0.85; display: flex; }
  .sidebar-link.active .icon { opacity: 1; }

  .sidebar-badge {
    margin-left: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 700;
    padding: 1px 5px; background: #2A2A28; color: #8A857A;
    flex-shrink: 0;
  }
  .sidebar-link.active .sidebar-badge { background: #8B0A1F; color: #F4F1E8; }

  .sidebar-collapse {
    margin-left: auto; width: 24px; height: 24px;
    background: transparent; border: 1px solid #2A2A28;
    color: #6A655A; cursor: pointer;
    display: grid; place-items: center;
    flex-shrink: 0;
  }
  .sidebar-collapse:hover { background: #1A1A18; color: #F4F1E8; }
  .sidebar.collapsed { width: 45px; }
  .sidebar.collapsed .sidebar-link span:not(.icon) { display: none; }
  .sidebar.collapsed .sidebar-section-title { display: none; }
  .sidebar.collapsed .sidebar-badge { display: none; }
  .sidebar.collapsed .sidebar-collapse { transform: rotate(180deg); }
</style>