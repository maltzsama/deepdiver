<%#
  Filter bar. Expects:
    url     - form action (GET)
    fields  - array of hashes: { name:, label:, options: [[label, value], ...] }
    search  - true/false to include the text search
%>
<%= form_with url: url, method: :get, class: "mb-4 flex flex-wrap items-end gap-3" do %>
  <% fields.each do |field| %>
    <div class="field">
      <%= label_tag field[:name], field[:label], class: "field-label text-xs" %>
      <%= select_tag field[:name],
                     options_for_select(field[:options], params[field[:name]]),
                     include_blank: t("filters.all"),
                     class: "field-input py-1.5 text-sm min-w-40" %>
    </div>
  <% end %>

  <% if local_assigns.fetch(:search, false) %>
    <div class="field grow">
      <%= label_tag :q, t("filters.search"), class: "field-label text-xs" %>
      <%= text_field_tag :q, params[:q],
                         placeholder: t("filters.search_placeholder"),
                         class: "field-input field-input-mono py-1.5 text-sm" %>
    </div>
  <% end %>

  <div class="flex items-center gap-2">
    <%= submit_tag t("filters.filter"), class: "btn btn-default",
                   data: { turbo_submits_with: t("filters.filtering") } %>
    <% if request.query_parameters.any? %>
      <%= link_to t("filters.clear"), url, class: "link text-sm" %>
    <% end %>
  </div>
<% end %>