<section class="panel">
  <div class="panel-body">
    <%= form_with model: schedule, class: "form-grid" do |f| %>
      <% if schedule.errors.any? %>
        <div class="errors">
          <p class="errors-title">
            <%= t("schedules.form.errors_#{schedule.errors.count == 1 ? "one" : "other"}",
                  count: schedule.errors.count) %>
          </p>
          <ul class="errors-list">
            <% schedule.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="field">
        <%= f.label :iceberg_table_id, t("schedules.form.table"), class: "field-label" %>
        <%= f.collection_select :iceberg_table_id,
                                IcebergTable.includes(:catalog).order(:namespace, :name),
                                :id, :fully_qualified_name,
                                { include_blank: t("schedules.form.table_placeholder") },
                                class: "field-input field-input-mono" %>
      </div>

      <div class="field">
        <%= f.label :operation, t("schedules.form.operation"), class: "field-label" %>
        <p class="field-hint"><%= t("schedules.form.operation_hint") %></p>
        <%= f.select :operation, MaintenanceSchedule::OPERATIONS, {}, class: "field-input field-input-mono" %>
      </div>

      <div class="field">
        <%= f.label :cron, t("schedules.form.cron"), class: "field-label" %>
        <p class="field-hint"><%= t("schedules.form.cron_hint") %></p>
        <%= f.text_field :cron, class: "field-input field-input-mono",
                         placeholder: t("schedules.form.cron_placeholder") %>
      </div>

      <div class="field">
        <label class="field-check">
          <%= f.check_box :is_paused, class: "field-checkbox" %>
          <%= t("schedules.form.start_paused") %>
        </label>
        <p class="field-hint"><%= t("schedules.form.start_paused_hint") %></p>
      </div>

      <div class="field-group">
        <p class="field-group-title"><%= t("schedules.form.params_title") %></p>
        <p class="field-hint mb-4"><%= t("schedules.form.params_hint") %></p>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="field">
            <%= label_tag "maintenance_schedule[config][file_size_threshold]",
                          t("schedules.form.file_size"), class: "field-label" %>
            <%= text_field_tag "maintenance_schedule[config][file_size_threshold]",
                               schedule.config&.dig("file_size_threshold"),
                               class: "field-input field-input-mono", placeholder: "128MB" %>
          </div>

          <div class="field">
            <%= label_tag "maintenance_schedule[config][retention_threshold]",
                          t("schedules.form.retention"), class: "field-label" %>
            <%= text_field_tag "maintenance_schedule[config][retention_threshold]",
                               schedule.config&.dig("retention_threshold"),
                               class: "field-input field-input-mono", placeholder: "7d" %>
            <p class="field-hint"><%= t("schedules.form.retention_hint") %></p>
          </div>
        </div>
      </div>

      <div class="form-actions">
        <%= f.submit t("schedules.form.submit"), class: "btn btn-primary" %>
        <%= link_to t("schedules.form.cancel"), maintenance_schedules_path, class: "link text-sm" %>
      </div>
    <% end %>
  </div>
</section>