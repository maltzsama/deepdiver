<% content_for :title, "#{t("schedules.index.title")} — LakeDeepDiver" %>

<div class="page-head">
  <div>
    <p class="page-eyebrow"><%= t("schedules.index.eyebrow") %></p>
    <h1 class="page-title"><%= t("schedules.index.title") %></h1>
    <p class="page-sub"><%= t("schedules.index.subtitle") %></p>
  </div>
  <% if current_user.admin? %>
    <div class="page-actions">
      <%= link_to t("schedules.index.new"), new_maintenance_schedule_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<% if @schedules.empty? %>
  <section class="panel">
    <div class="empty">
      <p class="empty-title"><%= t("schedules.index.empty_title") %></p>
      <p class="empty-hint"><%= t("schedules.index.empty_hint") %></p>
    </div>
  </section>
<% else %>
  <section class="panel">
    <div class="data-table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t("schedules.index.col_table") %></th>
            <th><%= t("schedules.index.col_operation") %></th>
            <th><%= t("schedules.index.col_cron") %></th>
            <th><%= t("schedules.index.col_state") %></th>
            <th><%= t("schedules.index.col_failures") %></th>
          </tr>
        </thead>
        <tbody>
          <% @schedules.each do |schedule| %>
            <tr>
              <td>
                <%= link_to schedule.iceberg_table.fully_qualified_name, schedule, class: "link-mono" %>
                <span class="ml-2 text-xs cell-muted"><%= schedule.iceberg_table.catalog.name %></span>
              </td>
              <td><span class="badge badge-neutral"><%= schedule.operation %></span></td>
              <td class="cell-id"><%= schedule.cron %></td>
              <td>
                <% if schedule.paused? %>
                  <span class="badge badge-critical"><span class="badge-dot"></span><%= t("schedules.index.paused") %></span>
                <% else %>
                  <span class="badge badge-healthy"><span class="badge-dot"></span><%= t("schedules.index.active") %></span>
                <% end %>
              </td>
              <td class="cell-num"><%= schedule.consecutive_failures %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>