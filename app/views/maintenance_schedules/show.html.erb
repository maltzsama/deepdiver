<% content_for :title, "#{@schedule.operation} — LakeDeepDiver" %>

<div class="page-head">
  <div>
    <p class="page-eyebrow">
      <%= t("schedules.show.eyebrow_prefix") %>
      <%= link_to @schedule.iceberg_table.fully_qualified_name,
                  @schedule.iceberg_table, class: "link" %>
    </p>
    <h1 class="page-title"><%= @schedule.operation %></h1>
  </div>

  <% if current_user.admin? %>
    <div class="page-actions">
      <%= link_to t("schedules.show.edit"), edit_maintenance_schedule_path(@schedule), class: "btn btn-default" %>
      <%= button_to t("schedules.show.delete"), maintenance_schedule_path(@schedule), method: :delete,
                    class: "btn btn-danger",
                    data: { turbo_confirm: t("schedules.show.delete_confirm") } %>
    </div>
  <% end %>
</div>

<section class="panel mb-6">
  <div class="panel-body">
    <dl class="dl">
      <div>
        <dt class="dl-term"><%= t("schedules.show.cron") %></dt>
        <dd class="dl-desc-mono"><%= @schedule.cron %></dd>
      </div>
      <div>
        <dt class="dl-term"><%= t("schedules.show.state") %></dt>
        <dd class="dl-desc">
          <% if @schedule.paused? %>
            <span class="badge badge-critical"><span class="badge-dot"></span><%= t("schedules.show.paused") %></span>
          <% else %>
            <span class="badge badge-healthy"><span class="badge-dot"></span><%= t("schedules.show.active") %></span>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="dl-term"><%= t("schedules.show.failures") %></dt>
        <dd class="dl-desc-mono"><%= @schedule.consecutive_failures %></dd>
      </div>
      <div>
        <dt class="dl-term"><%= t("schedules.show.params") %></dt>
        <dd class="dl-desc-mono text-small">
          <%= @schedule.config.presence&.to_json || t("schedules.show.params_default") %>
        </dd>
      </div>
    </dl>
  </div>
</section>

<%= render "shared/executions", executions: @executions %>