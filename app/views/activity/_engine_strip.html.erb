<%# Engine status strip with lifecycle stepper and phase detail.
     Also used by Turbo Stream broadcasts.
     Action buttons live in a separate frame so they survive
     broadcast_replace updates (which have no current_user). %>
<%
  status       = engine_state.status
  timer_mode   = engine_timer_mode(status)
  deadline     = engine_deadline(engine_state)
  queries      = local_assigns.fetch(:queries, 0)
%>
<section id="activity-engine-strip" class="panel mb-6"
         <% if timer_mode != "none" && deadline %>
         data-controller="engine-timer"
         data-engine-timer-mode-value="<%= timer_mode %>"
         data-engine-timer-deadline-value="<%= deadline %>"
         data-engine-timer-start-value="<%= engine_state.status_changed_at&.iso8601 %>"
         <% end %>>
  <div class="panel-head">
    <div class="flex flex-col">
      <h2 class="panel-title"><%= t("activity.engine.title") %></h2>
      <span class="panel-note"><%= engine_coordinator_target %></span>
    </div>
    <div class="flex items-center gap-3">
      <span class="panel-note"><%= t("activity.engine.active_count", count: local_assigns[:active_count]) %></span>
      <%# Admin actions (preserved in turbo_frame so they survive broadcast_replace) %>
      <%= turbo_frame_tag "activity-engine-actions" do %>
        <% if local_assigns.fetch(:render_actions, false) && current_user&.admin? %>
          <div class="flex items-center gap-2">
            <%= button_to t("activity.engine.retry"), restart_activity_path, method: :post,
                          class: "btn btn-default btn-sm" %>
            <%= button_to t("activity.engine.hard_reset"), hard_reset_activity_path, method: :post,
                          class: "btn btn-danger btn-sm",
                          data: { turbo_confirm: t("activity.engine.hard_reset_confirm") } %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="panel-body">
    <%# Lifecycle stepper: the active→next connector doubles as the countdown
        progress bar, filled via --engine-progress by the engine-timer controller. %>
    <div class="engine-stepper mb-3">
      <%= engine_lifecycle_stepper(status, timer: local_assigns[:engine_timer]) %>
    </div>

    <%# Phase detail: description on the left, time on the right. %>
    <div class="flex items-baseline justify-between gap-3">
      <span class="font-mono text-small text-cosmos-fg-soft">
        <%= engine_phase_detail(engine_state, queries: queries) %>
      </span>
      <span class="font-mono text-micro text-cosmos-fg-mute"
            <% if timer_mode != "none" %>data-engine-timer-target="label"<% end %>
            <% if timer_mode == "countdown" %>data-expired="<%= t("activity.engine.time_before_timeout", time: "0s") %>"<% end %>>
        <%= engine_phase_time(engine_state) %>
      </span>
    </div>

    <%# Error line for failed state %>
    <% if engine_state.last_error.present? %>
      <div class="mt-2">
        <span class="cell-muted font-mono text-small"><%= engine_state.last_error %></span>
      </div>
    <% end %>
  </div>
</section>
