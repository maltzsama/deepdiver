<% content_for :title, "#{t("activity.title")} — DeepDiver" %>

<div class="page-head">
  <div>
    <p class="page-eyebrow"><%= t("activity.eyebrow") %></p>
    <h1 class="page-title"><%= t("activity.title") %></h1>
    <p class="page-sub"><%= t("activity.subtitle") %></p>
  </div>
</div>

<%= turbo_stream_from "activity" %>

<%= render "engine_strip", engine_state: @engine_state, active_count: @running.size + @queued.size,
           render_actions: true, queries: @queries.size, engine_timer: true,
           engine_events: @engine_events, engine_idle: @engine_idle %>
<%= render "queue", queue: @queue, running: @running, queued: @queued %>
<%= render "in_progress", running: @running, queued: @queued, queries: @queries, typical_durations: @typical_durations %>
<%= render "engine_history", engine_events: @engine_events %>