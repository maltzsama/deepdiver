<%# Engine lifecycle history - rendered last on the activity screen. %>
<% events = Array(local_assigns[:engine_events]) %>
<% uptimes = engine_uptimes(events) %>
<section id="activity-engine-history" class="panel mb-6">
  <div class="panel-head">
    <h2 class="panel-title"><%= t("activity.engine.history_title") %></h2>
  </div>

  <% if events.any? %>
    <div class="data-table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col" class="w-[30%]"><%= t("activity.engine.col_when") %></th>
            <th scope="col" class="w-[35%]"><%= t("activity.engine.col_event") %></th>
            <th scope="col" class="w-[20%]"><%= t("activity.engine.col_engine") %></th>
            <th scope="col" class="w-[15%]"><%= t("activity.engine.col_uptime") %></th>
          </tr>
        </thead>
        <tbody>
          <% events.each do |event| %>
            <tr>
              <td>
                <span class="cell-muted"><%= timestamp(event.last_seen_at) %></span>
              </td>
              <td>
                <span class="badge <%= engine_status_badge_class(engine_event_label(event)) %>">
                  <span class="badge-dot"></span><%= engine_event_label(event) %>
                </span>
              </td>
              <td class="cell-muted">
                <%= engine_target_label %>
              </td>
              <td class="cell-num">
                <% gen = event.context&.dig("generation") %>
                <% if gen && uptimes[gen] %>
                  <%= duration_label(uptimes[gen]) %>
                <% else %>
                  <span class="cell-muted">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty">
      <p class="empty-title"><%= t("activity.engine.no_history") %></p>
    </div>
  <% end %>
</section>
