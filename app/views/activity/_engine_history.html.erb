<%# Engine lifecycle history - one row per session (generation), newest first.
     The coordinator deployment name lives once in the panel header. %>
<% sessions = engine_sessions(Array(local_assigns[:engine_events])) %>
<section id="activity-engine-history" class="panel mb-6">
  <div class="panel-head">
    <h2 class="panel-title"><%= t("activity.engine.history_title") %></h2>
    <span class="panel-note"><%= engine_target_label %></span>
  </div>

  <% if sessions.any? %>
    <div class="data-table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col"><%= t("activity.engine.col_started") %></th>
            <th scope="col"><%= t("activity.engine.col_ready") %></th>
            <th scope="col"><%= t("activity.engine.col_uptime") %></th>
            <th scope="col"><%= t("activity.engine.col_shutdown") %></th>
            <th scope="col"><%= t("activity.engine.col_attempts") %></th>
          </tr>
        </thead>
        <tbody>
          <% sessions.each do |session| %>
            <tr>
              <td><%= timestamp(session.started_at) %></td>
              <td class="cell-num">
                <% if session.ready_seconds %>
                  <%= duration_label(session.ready_seconds) %>
                <% else %>
                  <span class="cell-muted">—</span>
                <% end %>
              </td>
              <td class="cell-num">
                <% if session.running? && session.uptime_seconds %>
                  <%= t("activity.engine.session_running", time: duration_label(session.uptime_seconds)) %>
                <% elsif session.uptime_seconds %>
                  <%= duration_label(session.uptime_seconds) %>
                <% else %>
                  <span class="cell-muted">—</span>
                <% end %>
              </td>
              <td>
                <% if session.running? %>
                  <span class="cell-muted">—</span>
                <% elsif session.outcome == :failed %>
                  <span class="badge badge-err"><%= t("activity.engine.session_failed") %></span>
                <% else %>
                  <%= t("activity.engine.session_clean", time: duration_label(session.drain_seconds) || "—") %>
                <% end %>
              </td>
              <td class="cell-num">
                <%= session.attempts if session.attempts > 1 %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty">
      <p class="empty-title"><%= t("activity.engine.no_history") %></p>
    </div>
  <% end %>
</section>