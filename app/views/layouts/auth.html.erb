<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="dark">
  <head>
    <title><%= content_for(:title) || t("auth.brand") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-theme="dark">
    <div class="auth-shell">
      <section class="auth-brand">
        <div class="auth-brand-inner">
          <img src="/icon.svg" width="96" height="96" alt="LakeDeepDiver" aria-hidden="true">
          <p class="auth-mark"><%= t("auth.eyebrow") %></p>
          <h1 class="auth-title"><%= t("auth.brand") %></h1>
          <p class="auth-tagline"><%= t("auth.tagline") %></p>
          <p class="auth-version"><%= t("auth.version") %></p>

          <dl class="auth-facts">
            <div>
              <dd class="auth-fact-value">4</dd>
              <dt class="auth-fact-label"><%= t("auth.facts.operations") %></dt>
            </div>
            <div>
              <dd class="auth-fact-value"><%= Catalog.count %></dd>
              <dt class="auth-fact-label"><%= t("auth.facts.catalogs") %></dt>
            </div>
            <div>
              <dd class="auth-fact-value"><%= IcebergTable.count %></dd>
              <dt class="auth-fact-label"><%= t("auth.facts.tables") %></dt>
            </div>
          </dl>
        </div>

        <p class="auth-foot"><%= t("auth.footer") %></p>
      </section>

      <section class="auth-panel">
        <div class="auth-card">
          <div class="auth-mobile-brand">
            <p class="auth-mark"><%= t("auth.eyebrow") %></p>
            <p class="mt-1 text-2xl font-semibold text-cosmos-fg"><%= t("auth.brand") %></p>
          </div>

          <%= render "shared/flash" %>
          <%= yield %>
        </div>
      </section>
    </div>
  </body>
</html>